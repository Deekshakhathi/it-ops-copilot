# ── IT Ops Copilot: language-model configuration ─────────────────────────────
# Copy this file to `.env` at the project root and fill in what you use.
# The agent reads these variables at request time via `src/copilot/llm.py`.
# Never commit real keys — only this template.

# Which provider to use: "openai", "anthropic", or "none".
# When omitted, the provider is auto-detected from the key variables below.
LLM_PROVIDER=openai

# OpenAI (or any OpenAI-compatible endpoint: Azure, OpenRouter, Groq, vLLM,
# Ollama, LM Studio, etc.). ANTHROPIC_API_KEY works for Anthropic.
OPENAI_API_KEY=

ANTHROPIC_API_KEY=
LLM_API_KEY=          # generic key used when the provider-specific key is unset

# Model name (provider default applies when omitted, e.g. gpt-4o-mini):
LLM_MODEL=

# Base URL override for OpenAI-compatible endpoints:
LLM_BASE_URL=https://api.openai.com        # default
# LLM_BASE_URL=http://localhost:11434/v1   # example: local Ollama

# Base URL override for Anthropic:
ANTHROPIC_BASE_URL=https://api.anthropic.com  # default
